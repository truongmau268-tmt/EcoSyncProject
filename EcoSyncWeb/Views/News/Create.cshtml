@model EcoSyncWeb.Models.News
@{
    ViewData["Title"] = "Đăng bài viết mới";
}

<div class="container mt-4 mb-5 animate-fade-up">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                <div class="eco-page-header rounded-0 text-center py-4">
                    <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                        📰 Truyền thông xanh EcoSync
                    </span>
                    <h3 class="mb-0 fw-extrabold">➕ Đăng Bài Viết Mới</h3>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">📌 Tiêu đề bài viết</label>
                            <input asp-for="Title" class="form-control rounded-pill px-4 py-2" required placeholder="Nhập tiêu đề bài viết..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">📝 Nội dung bài viết</label>
                            <textarea asp-for="Content" class="form-control rounded-4 p-3" rows="10" required placeholder="Nhập nội dung chi tiết bài viết..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Manage" class="btn btn-light border rounded-pill px-4 fw-bold text-secondary">⬅ Quay lại</a>
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm">🚀 Đăng bài</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
