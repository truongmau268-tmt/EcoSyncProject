@model EcoSyncWeb.Models.News
@{
    ViewData["Title"] = Model.Title;
    var related = ViewBag.Related as List<EcoSyncWeb.Models.News> ?? new();
}

<div class="container mt-3 mb-5 animate-fade-up">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="mb-3">
                <a asp-action="Index" class="btn btn-white bg-white border rounded-pill px-4 fw-bold text-secondary shadow-sm">
                    ⬅ Về danh sách tin tức
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-bold">
                            🌿 Ban biên tập EcoSync
                        </span>
                        <span class="text-muted small">
                            🕒 Đăng ngày @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>

                    <h1 class="fw-extrabold text-dark mb-4" style="line-height: 1.3;">@Model.Title</h1>

                    <hr class="my-4 opacity-10" />

                    <div class="text-dark" style="line-height: 1.95; font-size: 1.05rem; white-space: pre-line;">@Model.Content</div>

                    <!-- PB20: Chia sẻ -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-5 pt-4 border-top">
                        <span class="fw-bold small text-secondary">📢 Lan tỏa bài viết này tới cộng đồng:</span>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold"
                               href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(Url.Action("Details", "News", new { id = Model.Id }, Context.Request.Scheme))"
                               target="_blank" rel="noopener">📘 Chia sẻ Facebook</a>
                            <a class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold"
                               href="https://zalo.me/share?u=@Uri.EscapeDataString(Url.Action("Details", "News", new { id = Model.Id }, Context.Request.Scheme))"
                               target="_blank" rel="noopener">💬 Chia sẻ Zalo</a>
                            <button class="btn btn-light border btn-sm rounded-pill px-3 fw-bold text-secondary"
                                    onclick="navigator.clipboard.writeText(location.href); alert('Đã sao chép liên kết bài viết!');">🔗 Sao chép liên kết</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (related.Any())
            {
                <h4 class="fw-bold text-dark mt-5 mb-3">📌 Bài viết liên quan</h4>
                <div class="row row-cols-1 row-cols-md-3 g-3">
                    @foreach (var item in related)
                    {
                        <div class="col">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                <div class="card h-100 border-0 shadow-sm rounded-4 bg-white p-4 eco-card-hover">
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 mb-2 align-self-start" style="font-size: 11px;">Tin tức xanh</span>
                                    <h6 class="fw-bold text-dark mb-2" style="line-height: 1.5;">@item.Title</h6>
                                    <span class="text-muted mt-auto pt-2" style="font-size: 12px;">🕒 @item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
