@model IEnumerable<EcoSyncWeb.Models.News>
@{
    ViewData["Title"] = "Quản lý tin tức";
}

<div class="container mt-3 mb-5 animate-fade-up">
    <div class="eco-page-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                ✍️ Quản trị nội dung truyền thông
            </span>
            <h2 class="fw-extrabold mb-1">📰 Quản Lý Tin Tức &amp; Bài Viết</h2>
            <p class="mb-0 text-white text-opacity-85 small">
                Đăng tải và biên tập các bài viết truyền thông môi trường hiển thị công khai trên hệ thống.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
            <a asp-action="Create" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">➕ Đăng bài mới</a>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-success shadow-sm">👁 Xem trang tin tức</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm text-center border-0" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table eco-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="py-3 ps-4">Tiêu đề &amp; Tóm tắt bài viết</th>
                        <th class="py-3">Ngày đăng</th>
                        <th class="py-3 pe-4 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-5">
                                <div class="fs-2 mb-2">📝</div>
                                Chưa có bài viết nào. Hãy đăng bài đầu tiên!
                            </td>
                        </tr>
                    }
                    @foreach (var news in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="fw-bold text-dark">@news.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 540px;">@news.Content</div>
                            </td>
                            <td class="small text-muted text-nowrap">
                                <i class="bi bi-calendar3 me-1"></i>@news.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="pe-4 text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">👁 Xem</a>
                                    <a asp-action="Edit" asp-route-id="@news.Id" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold">✏️ Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@news.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold"
                                       onclick="return confirm('Xóa bài viết này?');">🗑️ Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
