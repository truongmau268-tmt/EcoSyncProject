@model IEnumerable<EcoSyncWeb.Models.Feedback>
@{
    ViewData["Title"] = "Quản lý và Cấp Giấy Chứng Nhận";
    var project = ViewBag.Project as EcoSyncWeb.Models.Project;
    var certifiedNames = ViewBag.CertifiedNames as List<string> ?? new List<string>();
}

<div class="container mt-3 mb-5 animate-fade-up">
    <div class="eco-page-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                🏅 Xét duyệt &amp; Vinh danh Tình nguyện viên
            </span>
            <h2 class="fw-extrabold mb-1">🏆 Quản Lý &amp; Cấp Giấy Chứng Nhận</h2>
            <p class="mb-0 text-white text-opacity-85 small">
                Chiến dịch: <strong class="text-warning">@project?.Title</strong>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
            <a asp-action="Volunteers" asp-route-id="@project?.Id" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
                📋 Xem DS Tình Nguyện Viên
            </a>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-success shadow-sm">
                ⬅ Về danh sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm text-center border-0" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1 mb-2">📭</div>
                Chưa có tình nguyện viên nào gửi đánh giá cho chiến dịch này.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table eco-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="py-3 ps-4">Tình nguyện viên</th>
                            <th class="py-3">Đánh giá &amp; Ý kiến đóng góp</th>
                            <th class="py-3 text-center">Sắc thái AI</th>
                            <th class="py-3 pe-4 text-center">Thao tác cấp GCN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fb in Model)
                        {
                            bool isCertified = certifiedNames.Contains(fb.AuthorName);
                            var initial = !string.IsNullOrWhiteSpace(fb.AuthorName) ? fb.AuthorName.Trim()[0].ToString().ToUpper() : "V";
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="eco-avatar">@initial</span>
                                        <span class="fw-bold text-dark">@fb.AuthorName</span>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="text-warning mb-1" aria-label="@fb.Rating trên 5 sao">
                                        @string.Concat(Enumerable.Repeat("★", Math.Clamp(fb.Rating, 0, 5)))<span class="text-muted opacity-25">@string.Concat(Enumerable.Repeat("★", 5 - Math.Clamp(fb.Rating, 0, 5)))</span>
                                    </div>
                                    <span class="text-secondary small">@fb.Content</span>
                                </td>
                                <td class="text-center">
                                    @if (fb.Sentiment != null && fb.Sentiment.Contains("Tích cực"))
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">Tích cực 🌟</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">Cần cải thiện ⚠️</span>
                                    }
                                </td>
                                <td class="pe-4 text-center">
                                    @if (isCertified)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                            🏆 Đã cấp GCN
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-action="CertifyFeedback" asp-route-id="@fb.Id" class="btn btn-success rounded-pill px-4 fw-bold btn-sm shadow-sm">
                                            🏆 Cấp GCN ngay
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>