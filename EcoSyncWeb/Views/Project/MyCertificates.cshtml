@model IEnumerable<EcoSyncWeb.Models.Project>
@{
    ViewData["Title"] = "Giấy chứng nhận của tôi";
    var registrations = ViewBag.Registrations as List<EcoSyncWeb.Models.ProjectRegistration>;
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-success display-6">🏆 Phòng Vinh Danh & Giấy Chứng Nhận</h1>
        <p class="text-muted">Những ghi nhận và chứng nhận tình nguyện viên chính thức từ Ban Tổ Chức EcoSync.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm text-center" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm p-5">
            <span style="font-size: 48px;">🏅</span>
            <h4 class="fw-bold text-dark mt-3">Chưa có Giấy chứng nhận nào</h4>
            <p class="text-muted">Bạn sẽ nhận được Giấy chứng nhận điện tử sau khi hoàn thành xuất sắc các chiến dịch cộng đồng và được Admin phê duyệt.</p>
            <a asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold mt-2">Khám phá chiến dịch ngay</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var project in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 position-relative overflow-hidden" style="border: 3px solid #198754 !important; background: linear-gradient(0deg, #f8f9fa 0%, #ffffff 100%);">
                        <div class="card-body d-flex flex-column">
                            <span style="font-size: 40px;">🌿🏆🌿</span>
                            <h4 class="fw-bold text-uppercase text-success mt-2 mb-1">Giấy Chứng Nhận</h4>
                            <p class="text-muted small text-uppercase tracking-wider">EcoSync Community Platform</p>
                            
                            <hr class="w-25 mx-auto my-2" />

                            <p class="mb-1 text-secondary small">Chứng nhận tình nguyện viên:</p>
                            <h5 class="fw-bold text-dark">@User.Identity?.Name</h5>
                            <p class="text-secondary small mt-1 flex-grow-1">Đã hoàn thành chiến dịch:<br /><strong class="text-success">@project.Title</strong></p>

                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="badge bg-success px-3 py-2 rounded-pill small">Đã xác thực</span>
                                <a asp-action="Certificate" asp-route-projectId="@project.Id" class="btn btn-success rounded-pill px-4 fw-bold btn-sm shadow-sm">📜 Xem GCN Chi Tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>