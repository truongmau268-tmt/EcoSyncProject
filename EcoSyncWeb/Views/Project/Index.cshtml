@using System.Security.Claims
@model IEnumerable<EcoSyncWeb.Models.Project>
@{
    ViewData["Title"] = "Dự án cộng đồng";
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    var keyword = ViewBag.Keyword as string;
    var location = ViewBag.Location as string;
    var status = ViewBag.Status as string ?? "Tất cả";
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-success display-5">🌱 Dự Án & Chiến Dịch Cộng Đồng</h1>
        <p class="text-muted lead">Cùng nhau chung tay bảo vệ môi trường, lan tỏa lối sống xanh tại Đà Nẵng và toàn quốc.</p>

        @if (User.Identity != null && User.Identity.IsAuthenticated && userRole == "Admin")
        {
            <div class="mt-3">
                <a asp-action="Create" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">➕ Phát Động Chiến Dịch Mới</a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm text-center" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm text-center" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PB08: Tìm kiếm & lọc chiến dịch -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="keyword" value="@keyword" class="form-control rounded-pill px-3" placeholder="🔍 Tìm theo tên hoặc mô tả chiến dịch..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="location" value="@location" class="form-control rounded-pill px-3" placeholder="📍 Địa điểm (Sơn Trà...)" />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select rounded-pill px-3" asp-for="@status">
                    <option value="Tất cả">Tất cả trạng thái</option>
                    <option value="Sắp diễn ra">Sắp diễn ra</option>
                    <option value="Đang diễn ra">Đang diễn ra</option>
                    <option value="Đã kết thúc">Đã kết thúc</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-success rounded-pill fw-bold">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var project in Model)
        {
            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden bg-white">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            @if (project.Status == "Đã kết thúc")
                            {
                                <span class="badge bg-secondary px-3 py-2 rounded-pill">Đã kết thúc</span>
                            }
                            else if (project.Status == "Đang diễn ra")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Đang diễn ra</span>
                            }
                            else
                            {
                                <span class="badge bg-primary px-3 py-2 rounded-pill">Sắp diễn ra</span>
                            }
                            <span class="text-muted small fw-semibold">📅 @project.StartDate.ToString("dd/MM/yyyy")</span>
                        </div>

                        <h3 class="fw-bold text-dark mb-2">@project.Title</h3>
                        <p class="text-secondary small mb-2">
                            📍 @project.Location
                            @if (project.TargetVolunteers.HasValue)
                            {
                                <span> · 👥 Chỉ tiêu @project.TargetVolunteers TNV</span>
                            }
                        </p>

                        <p class="text-muted flex-grow-1" style="font-size: 14px; line-height: 1.6;">@project.Description</p>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                @if (project.Status == "Đã kết thúc")
                                {
                                    <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-success rounded-pill px-4 fw-bold btn-sm shadow-sm">Chi tiết & Đánh giá</a>
                                }
                                else
                                {
                                    <a asp-action="RegisterForm" asp-route-projectId="@project.Id" class="btn btn-success rounded-pill px-4 fw-bold btn-sm shadow-sm">Đăng ký tham gia</a>
                                }
                            </div>

                            @if (User.Identity != null && User.Identity.IsAuthenticated && userRole == "Admin")
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Volunteers" asp-route-id="@project.Id" class="btn btn-outline-primary rounded-pill px-3 fw-bold btn-sm">📋 Quản lý TNV</a>
                                    <a asp-action="CertificatesManagement" asp-route-id="@project.Id" class="btn btn-outline-success rounded-pill px-3 fw-bold btn-sm">🏆 Cấp GCN</a>
                                    <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-outline-warning rounded-pill px-3 fw-bold btn-sm">✏️ Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@project.Id" class="btn btn-outline-danger rounded-pill px-3 fw-bold btn-sm" onclick="return confirm('Bạn có chắc muốn xóa chiến dịch này không?');">🗑️ Xóa</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            Không tìm thấy chiến dịch nào khớp với từ khóa/bộ lọc. <a asp-action="Index" class="text-success fw-bold">Xóa bộ lọc</a>
        </div>
    }
</div>
