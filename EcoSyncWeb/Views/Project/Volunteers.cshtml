@model IEnumerable<EcoSyncWeb.Models.ProjectRegistration>
@{
    ViewData["Title"] = "Quản lý tình nguyện viên";
    var project = ViewBag.Project as EcoSyncWeb.Models.Project;
    var summaries = ViewBag.Summaries as Dictionary<int, EcoSyncWeb.Models.AiSummary> ?? new();
    bool aiReady = (bool)(ViewBag.AiReady ?? false);
    string aiProvider = ViewBag.AiProviderName as string ?? "AI";
    string StatusBadge(string s) => s switch
    {
        "Đã duyệt" => "bg-success",
        "Đã loại" => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="container mt-3 mb-5 animate-fade-up">
    <div class="eco-page-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                🤖 AI Recruitment &amp; Screening
            </span>
            <h2 class="fw-extrabold mb-1">📋 Quản Lý Tình Nguyện Viên</h2>
            <p class="mb-0 text-white text-opacity-85 small">
                Chiến dịch: <strong class="text-warning">@project?.Title</strong>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
            <a asp-action="CertificatesManagement" asp-route-id="@project?.Id" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
                📜 Chuyển đến Cấp GCN
            </a>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold text-success shadow-sm">
                ⬅ Về danh sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm text-center border-0" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm text-center border-0" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1 mb-2">👥</div>
                Chưa có tình nguyện viên nào đăng ký tham gia chiến dịch này.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table eco-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="py-3 ps-4">Họ và Tên / Ghi chú</th>
                            <th class="py-3">Liên hệ</th>
                            <th class="py-3 text-center">Trạng thái hồ sơ</th>
                            <th class="py-3 pe-4 text-center">Xét duyệt &amp; Đánh giá AI Summary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model)
                        {
                            var summary = summaries.TryGetValue(reg.Id, out var s) ? s : null;
                            var initial = !string.IsNullOrWhiteSpace(reg.FullName) ? reg.FullName.Trim()[0].ToString().ToUpper() : "T";
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="eco-avatar">@initial</span>
                                        <div>
                                            <div class="fw-bold text-dark">@reg.FullName</div>
                                            @if (!string.IsNullOrWhiteSpace(reg.Note))
                                            {
                                                <div class="text-muted small">@reg.Note</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    <div><i class="bi bi-envelope me-1"></i>@reg.Email</div>
                                    <div><i class="bi bi-telephone me-1"></i>@reg.Phone</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @StatusBadge(reg.Status) px-3 py-2 rounded-pill shadow-sm">@reg.Status</span>
                                    @if (reg.IsCertified)
                                    {
                                        <div class="small text-success fw-bold mt-1">🏆 Đã cấp GCN</div>
                                    }
                                </td>
                                <td class="pe-4 py-3" style="min-width: 340px;">
                                    <div class="d-flex gap-2 justify-content-center flex-wrap mb-2">
                                        @if (reg.Status != "Đã duyệt")
                                        {
                                            <a asp-action="SetRegistrationStatus" asp-route-id="@reg.Id" asp-route-status="Đã duyệt" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm">✅ Duyệt</a>
                                        }
                                        @if (reg.Status != "Đã loại")
                                        {
                                            <a asp-action="SetRegistrationStatus" asp-route-id="@reg.Id" asp-route-status="Đã loại" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">❌ Loại</a>
                                        }
                                        <a asp-action="GenerateAiSummary" asp-route-id="@reg.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" onclick="return confirm('Hệ thống sẽ phân tích độ phù hợp của hồ sơ bằng AI. Xác nhận thực hiện?');">
                                            🤖 AI Summary
                                        </a>
                                    </div>
                                    @if (summary != null)
                                    {
                                        <div class="rounded-4 p-3 text-start small mt-2 border" style="background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);">
                                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-2">
                                                <div class="fw-bold text-success">
                                                    🤖 AI Match: <span class="badge bg-success rounded-pill">@summary.MatchPercent% phù hợp</span>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold"
                                                        data-summary-toggle
                                                        aria-controls="ai-summary-details-@reg.Id"
                                                        aria-expanded="true">
                                                    Ẩn nhận xét
                                                </button>
                                            </div>
                                            <!-- Progress bar độ phù hợp -->
                                            <div class="progress mb-2" style="height: 7px; border-radius: 999px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @summary.MatchPercent%;" aria-valuenow="@summary.MatchPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <div id="ai-summary-details-@reg.Id">
                                                <div class="mb-1">🌟 <strong>Điểm mạnh:</strong> @summary.Strengths</div>
                                                <div class="mb-1">⚠️ <strong>Cần cải thiện:</strong> @summary.Weaknesses</div>
                                                <div class="text-muted">🧾 @summary.Overall</div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!aiReady)
            {
                <div class="alert alert-warning small rounded-0 mb-0 border-0 border-top px-4 py-3">
                    ⚙️ Chưa cấu hình khóa API Groq. Hãy đặt biến môi trường <code>GROQ_API_KEY</code> hoặc cấu hình <code>Groq:ApiKey</code> để sử dụng tính năng <strong>🤖 AI Summary</strong>.
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll("[data-summary-toggle]").forEach(button => {
            button.addEventListener("click", () => {
                const details = document.getElementById(button.getAttribute("aria-controls"));
                const isExpanded = button.getAttribute("aria-expanded") === "true";

                details.hidden = isExpanded;
                button.setAttribute("aria-expanded", String(!isExpanded));
                button.textContent = isExpanded ? "Xem nhận xét" : "Ẩn nhận xét";
            });
        });
    </script>
}
