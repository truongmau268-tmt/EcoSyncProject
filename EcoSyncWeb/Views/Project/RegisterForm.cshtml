@model EcoSyncWeb.Models.ProjectRegistration
@{
    ViewData["Title"] = "Đăng ký tình nguyện viên";
}

<div class="container mt-4 mb-5 animate-fade-up">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                <div class="eco-page-header rounded-0 text-center py-4">
                    <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                        🌱 Biểu mẫu ứng tuyển Tình nguyện viên
                    </span>
                    <h3 class="mb-1 fw-extrabold">Đăng Ký Tham Gia Chiến Dịch</h3>
                    <p class="mb-0 text-white text-opacity-85 small">@ViewBag.ProjectTitle</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="RegisterForm" method="post">
                        <input type="hidden" asp-for="ProjectId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">👤 Họ và Tên đầy đủ</label>
                            <input asp-for="FullName" class="form-control rounded-pill px-4 py-2" required placeholder="Nhập họ và tên đầy đủ của bạn..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">📞 Số điện thoại liên hệ (10 số / Zalo)</label>
                            <input asp-for="Phone" class="form-control rounded-pill px-4 py-2" required pattern="0\d{9}" title="Số điện thoại gồm đúng 10 số, bắt đầu bằng 0" placeholder="Ví dụ: 0905123456..." />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">🎓 Ghi chú (Khoa / Lớp / Đơn vị / Kỹ năng)</label>
                            <textarea asp-for="Note" class="form-control rounded-4 px-4 py-3" rows="3" placeholder="Ví dụ: Sinh viên năm 3 CNTT, có kinh nghiệm điều phối sự kiện..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a asp-action="Index" class="btn btn-light border rounded-pill px-4 fw-bold text-secondary">⬅ Quay lại</a>
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm">
                                ✅ Xác nhận đăng ký
                            </button>
                        </div>
                    </form>

                    <!-- PB09: Sau khi nộp đơn, tự động kích hoạt khung chat AI phỏng vấn sơ loại -->
                    <div class="mt-4 p-4 rounded-4 border" style="background: linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 100%); border-color: rgba(16, 185, 129, 0.3) !important;">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                            <div class="d-flex align-items-start gap-3">
                                <span class="eco-kpi-icon bg-success text-white flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.3rem;">🤖</span>
                                <div class="small">
                                    <div class="fw-bold text-dark fs-6 mb-1">Tăng cơ hội trúng tuyển với AI Phỏng vấn!</div>
                                    <div class="text-secondary">
                                        Trò chuyện ngắn cùng <strong>AI Phỏng vấn viên EcoSync</strong> để hoàn thiện hồ sơ năng lực — Admin sẽ dựa vào kết quả AI Summary để ưu tiên xét duyệt bạn!
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold text-nowrap flex-shrink-0 shadow-sm"
                                    onclick="ecosyncOpenChat('interview');">
                                🎤 Phỏng vấn ngay
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
