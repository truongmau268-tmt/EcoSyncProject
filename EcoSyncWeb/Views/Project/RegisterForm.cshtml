@model EcoSyncWeb.Models.ProjectRegistration
@{
    ViewData["Title"] = "Đăng ký tình nguyện viên";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 text-center rounded-top-4">
                    <h4 class="mb-0 fw-bold">Đăng ký tham gia chiến dịch</h4>
                </div>
                <div class="card-body p-4">
                    <h5 class="text-success fw-bold mb-4 text-center">@ViewBag.ProjectTitle</h5>

                    <form asp-action="RegisterForm" method="post">
                        <input type="hidden" asp-for="ProjectId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và Tên:</label>
                            <input asp-for="FullName" class="form-control rounded-pill px-3 py-2" required placeholder="Nhập họ và tên đầy đủ..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số điện thoại liên hệ (10 số):</label>
                            <input asp-for="Phone" class="form-control rounded-pill px-3 py-2" required pattern="0\d{9}" title="Số điện thoại gồm đúng 10 số, bắt đầu bằng 0" placeholder="Nhập số điện thoại (Zalo)..." />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Ghi chú (Khoa / Lớp / Đơn vị):</label>
                            <textarea asp-for="Note" class="form-control rounded-4 px-3 py-2" rows="3" placeholder="Ví dụ: Sinh viên năm 3 IT, Viện Việt Nhật..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 fw-bold">Quay lại</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">Xác nhận đăng ký</button>
                        </div>
                    </form>

                    <!-- PB09: Sau khi nộp đơn, tự động kích hoạt khung chat AI phỏng vấn sơ loại -->
                    <div class="alert alert-info rounded-4 mt-4 mb-0 small d-flex justify-content-between align-items-center gap-3">
                        <div>
                            🤖 <strong>Mẹo tăng cơ hội được duyệt:</strong> trò chuyện với
                            <strong>AI Phỏng vấn viên EcoSync</strong> ngay bây giờ để hoàn thiện hồ sơ năng lực —
                            Admin sẽ dựa vào transcript phỏng vấn và AI Summary để xét duyệt bạn!
                        </div>
                        <button type="button" class="btn btn-primary rounded-pill px-3 fw-bold text-nowrap flex-shrink-0"
                                onclick="ecosyncOpenChat('interview');">
                            🎤 Bắt đầu phỏng vấn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
