@model EcoSyncWeb.Models.Project
@{
    ViewData["Title"] = Model.Title;
    var feedbacks = ViewBag.Feedbacks as List<EcoSyncWeb.Models.Feedback> ?? new List<EcoSyncWeb.Models.Feedback>();
}

<div class="container mt-4 mb-5">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">⬅ Quay lại danh sách dự án</a>
    </div>

    <!-- Thông tin chi tiết chiến dịch -->
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="Ảnh chiến dịch @Model.Title" class="img-fluid mb-4 w-100" style="max-height: 420px; object-fit: cover; border-radius: 24px !important;" onerror="this.onerror=null;this.src='/uploads/projects/chiendich@(Model.Id).jpg';" />
        }
        <div class="d-flex justify-content-between align-items-center mb-3">
            @if (Model.Status == "Đã kết thúc")
            {
                <span class="badge bg-secondary px-3 py-2 rounded-pill">Đã kết thúc</span>
            }
            else
            {
                <span class="badge bg-primary px-3 py-2 rounded-pill">Sắp diễn ra</span>
            }
            <span class="text-muted fw-semibold">📅 Ngày diễn ra: @Model.StartTime.ToString("dd/MM/yyyy")</span>
        </div>

        <h1 class="fw-bold text-success display-6 mb-3">@Model.Title</h1>
        <p class="text-secondary fw-semibold fs-5 mb-4">📍 Địa điểm: @Model.Location</p>

        <hr />

        <h4 class="fw-bold text-dark mt-3 mb-2">Giới thiệu chiến dịch</h4>
        <p class="text-muted" style="font-size: 16px; line-height: 1.8;">@Model.Description</p>
    </div>

    <!-- ĐÁNH GIÁ SAU CHIẾN DỊCH -->
    <div class="mt-5">
        <h3 class="fw-bold text-success mb-2">💬 Đóng góp ý kiến &amp; Đánh giá chiến dịch</h3>
        <p class="text-muted mb-4">Chia sẻ trải nghiệm của bạn sau khi tham gia chiến dịch.</p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger rounded-3" role="alert">@TempData["ErrorMessage"]</div>
        }

        @if (ViewBag.HasSubmittedFeedback == true)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white" style="border: 2px solid #198754 !important;">
                <div class="mb-3">
                    <span style="font-size: 50px;">🎉</span>
                </div>
                <h4 class="fw-bold text-success mb-2">Cảm ơn bạn đã gửi đánh giá!</h4>
                <p class="text-secondary mb-0">Phản hồi của bạn đã được ghi nhận.</p>
            </div>
        }
        else if (ViewBag.CanSubmitFeedback == true)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <form asp-controller="Feedback" asp-action="Submit" method="post">
                    <input type="hidden" name="projectId" value="@Model.Id" />

                    <fieldset class="mb-4">
                        <legend class="fw-bold text-dark fs-6 mb-2">Đánh giá chiến dịch</legend>
                        <div class="star-rating" role="radiogroup" aria-label="Chọn số sao đánh giá">
                            @for (var rating = 5; rating >= 1; rating--)
                            {
                                var inputId = $"rating-{rating}";
                                <input class="star-rating-input" type="radio" name="rating" id="@inputId" value="@rating" required />
                                <label class="star-rating-label" for="@inputId" title="@rating sao" aria-label="@rating sao">★</label>
                            }
                        </div>
                    </fieldset>

                    <div class="mb-3">
                        <label for="feedback-content" class="fw-bold text-dark d-block mb-2">Chia sẻ cảm nhận và góp ý của bạn</label>
                        <textarea id="feedback-content" name="content" class="form-control rounded-4 p-3" rows="4"
                                  maxlength="1000" placeholder="Nhập chia sẻ hoặc góp ý của bạn..." required></textarea>
                        <div class="form-text">Tối đa 1000 ký tự.</div>
                    </div>

                    <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm">Gửi đánh giá</button>
                </form>
            </div>
        }
        else
        {
            <div class="alert alert-info rounded-4" role="status">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <span>@ViewBag.FeedbackEligibilityMessage </span>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.LoginReturnUrl" class="alert-link">Đăng nhập</a>
                }
                else
                {
                    @ViewBag.FeedbackEligibilityMessage
                }
            </div>
        }

        <!-- Danh sách phản hồi đã gửi -->
        <h4 class="fw-bold text-success mt-5 mb-3">💬 Ý Kiến Đóng Góp Từ Tình Nguyện Viên</h4>
        <style>
            .star-rating {
                display: inline-flex;
                flex-direction: row-reverse;
                justify-content: flex-end;
                gap: .3rem;
                padding: .55rem .8rem;
                border: 1px solid #ffe08a;
                border-radius: 1rem;
                background: linear-gradient(135deg, #fffdf4, #fff8dd);
            }

            .star-rating-input {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                clip-path: inset(50%);
            }

            .star-rating-label {
                color: #d5d9df;
                cursor: pointer;
                font-size: 2.7rem;
                line-height: 1;
                text-shadow: 0 1px 2px rgba(122, 91, 0, .18);
                transition: color .15s ease-in-out, transform .15s ease-in-out;
            }

            .star-rating-label:hover,
            .star-rating-label:hover ~ .star-rating-label,
            .star-rating-input:checked ~ .star-rating-label {
                color: #ffc107;
            }

            .star-rating-label:hover {
                transform: scale(1.12);
            }

            .star-rating-input:focus-visible + .star-rating-label {
                outline: 2px solid #198754;
                outline-offset: 3px;
                border-radius: .2rem;
            }
        </style>

        @if (!feedbacks.Any())
        {
            <div class="text-center py-4 bg-white rounded-4 shadow-sm text-muted">
                Chưa có đánh giá nào cho chiến dịch này.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var fb in feedbacks)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0">👤 @fb.AuthorName</h6>
                            <span class="text-muted small">🕒 @fb.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="text-warning mb-2" aria-label="@fb.Rating trên 5 sao">@string.Concat(Enumerable.Repeat("★", Math.Clamp(fb.Rating, 0, 5)))@string.Concat(Enumerable.Repeat("☆", 5 - Math.Clamp(fb.Rating, 0, 5)))</div>
                        <p class="text-secondary mb-0">@fb.Content</p>
                    </div>

                }
            </div>

        }
    </div>
