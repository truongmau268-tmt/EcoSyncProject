@model IEnumerable<EcoSyncWeb.Models.Project>
@{
    ViewData["Title"] = "Chiến dịch đã đăng ký";
    var registrations = ViewBag.Registrations as List<EcoSyncWeb.Models.ProjectRegistration>;

    string StatusBadge(string s) => s switch
    {
        "Đã duyệt" => "bg-success",
        "Đã loại" => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-success mb-1">Chiến dịch của tôi</h2>
            <p class="text-muted mb-0">Theo dõi tiến độ hồ sơ ứng tuyển: Chờ duyệt → Đã duyệt → hoàn thành & nhận giấy chứng nhận.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">⬅ Xem tất cả chiến dịch</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-5">
            <h4 class="text-muted mb-3">Bạn chưa đăng ký tham gia chiến dịch nào cả!</h4>
            <p class="text-muted mb-4">Hãy khám phá các chiến dịch môi trường sắp diễn ra và chung tay cùng cộng đồng nhé.</p>
            <a asp-action="Index" class="btn btn-danger fw-bold rounded-pill px-5 shadow-sm">Khám phá chiến dịch ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var regInfo = registrations?.FirstOrDefault(r => r.ProjectId == item.Id);
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-4" style="border-top: 4px solid #198754 !important;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                @if (regInfo != null)
                                {
                                    <span class="badge @StatusBadge(regInfo.Status) px-3 py-2 rounded-pill">
                                        📌 @(regInfo.Status)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Đã đăng ký tham gia</span>
                                }
                                <span class="text-muted small"><strong class="text-dark">📅 Ngày diễn ra:</strong> @item.StartDate.ToString("dd/MM/yyyy")</span>
                            </div>

                            <h4 class="card-title fw-bold text-dark mt-3">@item.Title</h4>
                            <p class="card-text text-muted mt-2" style="line-height: 1.6;">
                                @item.Description
                            </p>

                            <p class="mb-2 text-secondary small">
                                <strong class="text-danger">📍 Địa điểm:</strong> @item.Location
                            </p>

                            @if (regInfo != null)
                            {
                                <div class="bg-light p-3 rounded-3 mt-3 small text-muted">
                                    <div class="fw-bold text-dark mb-1">📝 Thông tin bạn đã đăng ký:</div>
                                    <div>- Họ tên: <strong>@regInfo.FullName</strong></div>
                                    <div>- SĐT: <strong>@regInfo.Phone</strong></div>
                                    <div>- Thời gian đăng ký: @regInfo.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (regInfo.IsCertified)
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-success px-3 py-2 rounded-pill">🏆 Đã cấp Giấy chứng nhận @(string.IsNullOrWhiteSpace(regInfo.CertificateCode) ? "" : "- Mã " + regInfo.CertificateCode)</span>
                                            <a asp-action="Certificate" asp-route-projectId="@item.Id" class="btn btn-success btn-sm rounded-pill px-3 fw-bold ms-1">Xem GCN</a>
                                        </div>
                                    }
                                    else if (regInfo.IsEvaluated)
                                    {
                                        <div class="mt-2 text-success">✅ Đã hoàn thành khảo sát — đang chờ Ban tổ chức cấp Giấy chứng nhận.</div>
                                    }
                                    else if (item.Status == "Đã kết thúc" && regInfo.Status == "Đã duyệt")
                                    {
                                        <div class="mt-2 text-warning">⏳ Chiến dịch đã kết thúc — hãy gửi đánh giá ở trang chi tiết để nhận Giấy chứng nhận!</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
