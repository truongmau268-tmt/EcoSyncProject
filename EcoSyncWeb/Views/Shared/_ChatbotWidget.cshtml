<!-- Bong bóng Chatbot nổi ở góc màn hình -->
<style>
    .chatbot-fab {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #059669 0%, #10b981 55%, #0d9488 100%);
        border: 2px solid rgba(255, 255, 255, 0.8);
        animation: pulseRing 2.5s infinite;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .chatbot-fab:hover {
        transform: scale(1.08) translateY(-3px);
    }
    .chatbot-panel {
        width: 375px;
        max-width: calc(100vw - 32px);
        height: 530px;
        max-height: calc(100vh - 120px);
        position: absolute;
        bottom: 80px;
        right: 0;
        overflow: hidden;
        border-radius: 1.5rem !important;
        box-shadow: 0 24px 48px -12px rgba(6, 78, 59, 0.28) !important;
        border: 1px solid rgba(16, 185, 129, 0.25) !important;
        display: flex;
        flex-direction: column;
        animation: fadeInUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .chatbot-header {
        background: linear-gradient(135deg, #064e3b 0%, #059669 60%, #0d9488 100%);
        color: #fff;
        padding: 0.9rem 1.1rem;
    }
    .chatbot-msg-user {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #fff;
        border-radius: 1.15rem 1.15rem 0.25rem 1.15rem;
        padding: 0.7rem 1rem;
        font-size: 0.88rem;
        line-height: 1.5;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }
    .chatbot-msg-bot {
        background: #ffffff;
        color: #1e293b;
        border: 1px solid rgba(16, 185, 129, 0.16);
        border-radius: 1.15rem 1.15rem 1.15rem 0.25rem;
        padding: 0.75rem 1rem;
        font-size: 0.88rem;
        line-height: 1.55;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    }
    .typing-dots span {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin: 0 2px;
        background-color: #10b981;
        border-radius: 50%;
        animation: bounceDot 1.2s infinite ease-in-out both;
    }
    .typing-dots span:nth-child(1) { animation-delay: -0.24s; }
    .typing-dots span:nth-child(2) { animation-delay: -0.12s; }
    @@keyframes bounceDot {
        0%, 80%, 100% { transform: scale(0.4); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
    }
</style>

<div id="ecosync-chatbot-container" class="no-print" style="position: fixed; bottom: 24px; right: 24px; z-index: 9999;">
    <!-- Nút bấm mở/đóng khung chat -->
    <button id="chatbot-toggle-btn" class="btn rounded-circle shadow-lg d-flex align-items-center justify-content-center chatbot-fab" title="Trợ lý AI EcoSync">
        <span style="font-size: 28px;">🤖</span>
    </button>

    <!-- Khung cửa sổ chat -->
    <div id="chatbot-window" class="card chatbot-panel d-none">
        <!-- Header -->
        <div class="chatbot-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 18px;">🤖</span>
                    <div>
                        <h6 class="mb-0 fw-bold" id="chatbot-title" style="font-size: 0.95rem;">💬 Trợ lý AI EcoSync</h6>
                        <span class="d-inline-flex align-items-center gap-1" style="font-size: 0.72rem; opacity: 0.85;">
                            <span class="rounded-circle bg-warning d-inline-block" style="width: 7px; height: 7px;"></span>
                            Groq AI trực tuyến
                        </span>
                    </div>
                </div>
                <button id="chatbot-close-btn" class="btn-close btn-close-white"></button>
            </div>
            <!-- Chuyển chế độ: Tư vấn <-> Phỏng vấn AI -->
            <div class="btn-group btn-group-sm mt-2 w-100 bg-black bg-opacity-25 p-1 rounded-pill" role="group">
                <button type="button" id="chatbot-mode-advice" class="btn btn-light rounded-pill fw-bold active" style="font-size: 0.78rem;">💬 Tư vấn chiến dịch</button>
                <button type="button" id="chatbot-mode-interview" class="btn btn-outline-light rounded-pill fw-bold border-0" style="font-size: 0.78rem;"
                        disabled="@(User.Identity?.IsAuthenticated != true)"
                        title="@(User.Identity?.IsAuthenticated == true ? "" : "Đăng nhập để sử dụng phỏng vấn AI")">🎤 Phỏng vấn AI</button>
            </div>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="text-center mt-1" style="font-size: 0.74rem;">
                    <a asp-controller="Account" asp-action="Login" class="link-light text-decoration-underline">Đăng nhập để mở khóa Phỏng vấn AI →</a>
                </div>
            }
        </div>

        <!-- Nội dung tin nhắn -->
        <div id="chatbot-messages" class="card-body overflow-auto flex-grow-1" style="background: #f4fbf7; padding: 14px; display: flex; flex-direction: column; gap: 10px;"></div>

        <!-- Ô nhập tin nhắn -->
        <div class="card-footer bg-white border-top p-2 d-flex align-items-center gap-2">
            <input type="text" id="chatbot-input" class="form-control rounded-pill px-3 border-0 bg-light" placeholder="Nhập câu hỏi hoặc câu trả lời..." style="font-size: 13.5px;" />
            <button id="chatbot-send-btn" class="btn btn-success rounded-pill px-3 py-2 fw-bold shadow-sm flex-shrink-0">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("chatbot-toggle-btn");
        const closeBtn = document.getElementById("chatbot-close-btn");
        const chatWindow = document.getElementById("chatbot-window");
        const sendBtn = document.getElementById("chatbot-send-btn");
        const inputField = document.getElementById("chatbot-input");
        const messagesContainer = document.getElementById("chatbot-messages");
        const modeAdviceBtn = document.getElementById("chatbot-mode-advice");
        const modeInterviewBtn = document.getElementById("chatbot-mode-interview");
        const chatTitle = document.getElementById("chatbot-title");
        const canInterview = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

        // Trạng thái phiên chat
        let chatMode = "advice";          // advice | interview
        let chatHistory = [];             // [{role, text}] - gửi kèm để Groq nhớ ngữ cảnh
        let interviewEnded = false;       // ẩn khi [KẾT THÚC PHỎNG VẤN]

        const WELCOME_ADVICE = "👋 Chào bạn! Mình là trợ lý AI EcoSync (Groq). Bạn cần tư vấn về chiến dịch môi trường nào tại Đà Nẵng không?";
        const WELCOME_INTERVIEW = "🎤 Chào ứng viên! Mình là AI phỏng vấn viên EcoSync. Mình sẽ đặt 5 câu hỏi ngắn để hiểu rõ bạn hơn. Bạn sẵn sàng chứ? Hãy trả lời: \"Mình sẵn sàng\"";

        function escapeHtml(s) {
            return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
        // Hiển thị **in đậm** và xuống dòng đơn giản
        function renderRich(s) {
            return escapeHtml(s)
                .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
                .replace(/\n/g, "<br>");
        }

        function resetConversation(mode) {
            chatHistory = [];
            interviewEnded = false;
            messagesContainer.innerHTML = "";
            addBotBubble(mode === "interview" ? WELCOME_INTERVIEW : WELCOME_ADVICE);
        }

        function addUserBubble(text) {
            messagesContainer.innerHTML += `
                <div class="d-flex justify-content-end mb-1">
                    <div class="chatbot-msg-user" style="max-width: 82%;">
                        ${renderRich(text)}
                    </div>
                </div>`;
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function addBotBubble(text, source) {
            const badge = source === "fallback"
                ? `<span class="badge bg-warning text-dark mb-1" style="font-size:9px;">chế độ dự phòng</span><br>`
                : "";
            messagesContainer.innerHTML += `
                <div class="d-flex align-items-end gap-2 mb-1">
                    <span class="eco-avatar" style="width: 26px; height: 26px; font-size: 13px;">🤖</span>
                    <div class="chatbot-msg-bot" style="max-width: 82%;">
                        ${badge}${renderRich(text)}
                    </div>
                </div>`;
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function addTypingBubble() {
            messagesContainer.innerHTML += `
                <div class="d-flex align-items-center gap-2 mb-1" id="chatbot-typing">
                    <span class="eco-avatar" style="width: 26px; height: 26px; font-size: 13px;">🤖</span>
                    <div class="chatbot-msg-bot py-2 px-3">
                        <span class="typing-dots"><span></span><span></span><span></span></span>
                        <span class="text-muted ms-1" style="font-size: 12px;">AI đang phản hồi...</span>
                    </div>
                </div>`;
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        function removeTypingBubble() {
            const el = document.getElementById("chatbot-typing");
            if (el) el.remove();
        }

        function setMode(mode) {
            if (mode === "interview" && !canInterview) {
                mode = "advice";
                resetConversation(mode);
                addBotBubble("Bạn cần đăng nhập để sử dụng tính năng phỏng vấn AI. Hãy chọn liên kết đăng nhập phía trên nhé.");
                return;
            }

            chatMode = mode;
            modeAdviceBtn.classList.toggle("active", mode === "advice");
            modeAdviceBtn.classList.toggle("btn-light", mode === "advice");
            modeAdviceBtn.classList.toggle("btn-outline-light", mode !== "advice");
            modeAdviceBtn.classList.toggle("border-0", mode !== "advice");

            modeInterviewBtn.classList.toggle("active", mode === "interview");
            modeInterviewBtn.classList.toggle("btn-light", mode === "interview");
            modeInterviewBtn.classList.toggle("btn-outline-light", mode !== "interview");
            chatTitle.textContent = mode === "interview" ? "🎤 AI Phỏng vấn EcoSync" : "💬 Trợ lý AI EcoSync";
            resetConversation(mode);
        }

        function openChat(mode) {
            chatWindow.classList.remove("d-none");
            if (mode) setMode(mode);
            inputField.focus();
        }
        // Hàm toàn cục: các trang khác có thể tự mở chat (PB09 - tự kích hoạt khi ứng tuyển)
        window.ecosyncOpenChat = openChat;

        toggleBtn.addEventListener("click", () => {
            if (!chatWindow.classList.contains("d-none")) { chatWindow.classList.add("d-none"); }
            else { openChat(chatMode); }
        });
        closeBtn.addEventListener("click", () => chatWindow.classList.add("d-none"));
        modeAdviceBtn.addEventListener("click", () => setMode("advice"));
        modeInterviewBtn.addEventListener("click", () => setMode("interview"));

        // Gửi tin nhắn
        async function sendMessage() {
            const text = inputField.value.trim();
            if (!text) return;
            if (chatMode === "interview" && interviewEnded) {
                addBotBubble("🎉 Phiên phỏng vấn đã kết thúc. Cảm ơn bạn đã tham gia! Bạn có thể chuyển sang chế độ **💬 Tư vấn** để hỏi thêm về EcoSync.");
                inputField.value = "";
                return;
            }

            addUserBubble(text);
            chatHistory.push({ role: "user", text: text });
            inputField.value = "";
            addTypingBubble();

            try {
                const response = await fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text, mode: chatMode, history: chatHistory.slice(0, -1).slice(-12) })
                });
                const data = await response.json();
                removeTypingBubble();

                addBotBubble(data.reply, data.source);
                chatHistory.push({ role: "model", text: data.reply });
                if (chatMode === "interview" && data.reply && data.reply.includes("[KẾT THÚC PHỎNG VẤN]")) {
                    interviewEnded = true;
                }
            } catch (error) {
                removeTypingBubble();
                addBotBubble("⚠️ Lỗi kết nối tới máy chủ. Vui lòng thử lại sau!", "fallback");
                console.error("Lỗi kết nối chatbot:", error);
            }
        }

        sendBtn.addEventListener("click", sendMessage);
        inputField.addEventListener("keypress", function (e) {
            if (e.key === 'Enter') sendMessage();
        });

        // Khởi tạo lời chào mặc định
        resetConversation("advice");
    });
</script>
