<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoSync Đà Nẵng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Ambient Decorative Blobs -->
    <div class="eco-ambient-blob blob-1"></div>
    <div class="eco-ambient-blob blob-2"></div>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light eco-navbar mb-3">
            <div class="container">
                <a class="navbar-brand eco-brand" asp-controller="Project" asp-action="Index">
                    <span class="eco-brand-icon">🌱</span>
                    <span>EcoSync</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Project" asp-action="Index">
                                <i class="bi bi-globe-asia-australia text-success me-1"></i>Dự án cộng đồng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">
                                <i class="bi bi-newspaper text-success me-1"></i>Tin tức xanh
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Project" asp-action="MyRegistrations">
                                    <i class="bi bi-bookmark-check text-success me-1"></i>Chiến dịch của tôi
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-highlight" asp-controller="Project" asp-action="MyCertificates">
                                    🏆 GCN của tôi
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item ms-lg-1">
                                    <a class="nav-link nav-link-highlight" asp-controller="Feedback" asp-action="Analytics">
                                        📊 Phân tích AI
                                    </a>
                                </li>
                                <li class="nav-item ms-lg-1">
                                    <a class="nav-link" asp-controller="Account" asp-action="Users">
                                        👥 Thành viên
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-2 mt-2 mt-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var initial = !string.IsNullOrWhiteSpace(User.Identity.Name) ? User.Identity.Name.Trim()[0].ToString().ToUpper() : "U";
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill border bg-white shadow-sm" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="eco-avatar" style="width: 30px; height: 30px; font-size: 0.8rem;">@initial</span>
                                    <span class="fw-bold text-dark small">@User.Identity.Name</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-success rounded-pill" style="font-size: 0.65rem;">Admin</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2">
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 fw-medium" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge text-success me-2"></i>Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 fw-medium" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-shield-lock text-warning me-2"></i>Đổi mật khẩu
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 fw-medium" asp-controller="News" asp-action="Manage">
                                                <i class="bi bi-journal-richtext text-primary me-2"></i>Quản lý tin tức
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 fw-medium" asp-controller="Feedback" asp-action="Analytics">
                                                <i class="bi bi-bar-chart-line text-success me-2"></i>AI Dashboard
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-success px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" asp-controller="Account" asp-action="Register">
                                    ✨ Tham gia ngay
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="eco-footer py-4 mt-5 no-print">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-inline-flex align-items-center gap-2 fw-bold text-success fs-5 mb-1">
                        <span class="eco-brand-icon" style="width: 28px; height: 28px; font-size: 0.9rem;">🌱</span>
                        <span>EcoSync Community Platform</span>
                    </div>
                    <p class="text-muted small mb-0">
                        Nền tảng kết nối tình nguyện viên &amp; quản lý chiến dịch môi trường thông minh tích hợp AI tại Đà Nẵng.
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-inline-flex flex-wrap justify-content-center gap-3 small fw-semibold mb-1">
                        <a asp-controller="Project" asp-action="Index" class="text-decoration-none text-secondary">Chiến dịch</a>
                        <a asp-controller="News" asp-action="Index" class="text-decoration-none text-secondary">Tin tức xanh</a>
                        <a href="javascript:void(0)" onclick="window.ecosyncOpenChat && window.ecosyncOpenChat('advice')" class="text-decoration-none text-success">🤖 Trợ lý AI</a>
                    </div>
                    <div class="text-muted" style="font-size: 0.78rem;">
                        &copy; 2026 EcoSync Đà Nẵng · Chung tay vì một Việt Nam xanh bền vững
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Nhúng lại Chatbot Widget -->
    @await Html.PartialAsync("_ChatbotWidget")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
