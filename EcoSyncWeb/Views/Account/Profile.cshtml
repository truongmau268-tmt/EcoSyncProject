@model EcoSyncWeb.Models.User
@{
    ViewData["Title"] = "Thông tin tài khoản";
    var initial = !string.IsNullOrWhiteSpace(Model?.FullName) ? Model.FullName.Trim()[0].ToString().ToUpper() : "U";
}

<div class="container mt-4 mb-5 animate-fade-up">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                <!-- Header Banner với Avatar -->
                <div class="eco-page-header rounded-0 py-4 px-4 px-md-5 d-flex flex-column flex-sm-row align-items-center gap-3 text-center text-sm-start">
                    <div class="rounded-circle bg-white text-success fw-extrabold d-flex align-items-center justify-content-center shadow"
                         style="width: 72px; height: 72px; font-size: 2rem; flex-shrink: 0;">
                        @initial
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2 mb-1">
                            <h3 class="mb-0 fw-extrabold">@(Model?.FullName ?? "Thành viên EcoSync")</h3>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold">
                                @(Model?.Role == "Admin" ? "👑 Quản trị viên" : "🌱 Cộng tác viên")
                            </span>
                        </div>
                        <p class="mb-0 text-white text-opacity-85 small">
                            📧 @Model?.Email · Cập nhật hồ sơ năng lực để AI gợi ý và xét duyệt chiến dịch chính xác hơn.
                        </p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 small" role="alert">
                            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="EditProfile" method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">👤 Họ và Tên</label>
                                <input type="text" name="FullName" class="form-control rounded-pill px-4 py-2" value="@Model?.FullName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">📧 Email (Định danh tài khoản)</label>
                                <input type="email" class="form-control rounded-pill px-4 py-2 bg-light text-muted" value="@Model?.Email" disabled />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">📞 Số điện thoại (10 số)</label>
                                <input type="text" name="Phone" class="form-control rounded-pill px-4 py-2" value="@Model?.Phone" placeholder="Chưa cập nhật..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">🏅 Vai trò hệ thống</label>
                                <div class="pt-1">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                        @(Model?.Role ?? "Collaborator")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">🛠 Kỹ năng bản thân (tối đa 1000 ký tự — phục vụ AI xét duyệt)</label>
                            <textarea name="Skills" class="form-control rounded-4 p-3" rows="3" maxlength="1000"
                                      placeholder="Ví dụ: Giao tiếp - thuyết trình, sơ cứu y tế, thiết kế poster Canva, nhiếp ảnh, tiếng Anh giao tiếp...">@Model?.Skills</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">🎖 Kinh nghiệm tình nguyện (tối đa 1000 ký tự)</label>
                            <textarea name="Experience" class="form-control rounded-4 p-3" rows="3" maxlength="1000"
                                      placeholder="Ví dụ: Tham gia Earth Day 2025 tại Đà Nẵng, thành viên CLB Xanh trường ĐH Duy Tân...">@Model?.Experience</textarea>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2 border-top">
                            <a asp-action="ChangePassword" class="btn btn-outline-warning rounded-pill px-4 fw-bold">
                                🔐 Đổi mật khẩu
                            </a>
                            <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm px-5">
                                💾 Lưu thay đổi hồ sơ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
