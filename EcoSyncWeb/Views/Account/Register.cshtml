@{
    ViewData["Title"] = "Đăng ký";
}

<style>
    .register-card {
        max-width: 900px;
        border-radius: 32px !important;
        overflow: hidden;
    }

    .register-card .left-box {
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        border-radius: 28px !important;
    }

    .register-card .featured-image {
        width: 100%;
        max-width: 360px;
        height: 250px;
        border-radius: 28px;
        overflow: hidden;
    }

    .register-card .featured-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 28px !important;
        mix-blend-mode: screen;
    }

    .register-card .form-control {
        border-radius: 50rem !important;
    }

    .register-card .btn {
        border-radius: 50rem !important;
    }

    .register-card .alert {
        border-radius: 20px !important;
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="row border p-3 bg-white shadow-lg box-area w-100 register-card">

        <!-- Cột trái -->
        <div class="col-md-6 overflow-hidden d-flex justify-content-center align-items-center flex-column left-box p-4">
            <div class="featured-image mb-3 text-center w-100">
                <img src="~/dangnhap.jpg" asp-append-version="true" alt="EcoSync"
                     class="img-fluid shadow-lg border border-white border-opacity-25" />
            </div>
            <p class="text-white fs-2 text-center fw-bold">Gia nhập EcoSync</p>
            <p class="text-white text-center small" style="opacity: 0.85; line-height: 1.6;">
                Đăng ký tài khoản tình nguyện viên để cùng chung tay bảo vệ môi trường, nhận Giấy chứng nhận và tham gia các chiến dịch ý nghĩa.
            </p>
        </div>

        <!-- Cột phải -->
        <div class="col-md-6 right-box d-flex justify-content-center align-items-center p-4">
            <div class="w-100">
                <div class="header-text mb-3 text-center">
                    <h3 class="fw-bold text-dark">Tạo tài khoản</h3>
                    <p class="text-muted small">Điền thông tin để trở thành thành viên EcoSync.</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 small text-center">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Họ và tên</label>
                        <input name="fullName" type="text" class="form-control bg-light fs-6 px-4 py-2"
                               placeholder="Nhập họ tên đầy đủ..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Email</label>
                        <input name="email" type="email" class="form-control bg-light fs-6 px-4 py-2"
                               placeholder="Nhập địa chỉ email..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Số điện thoại</label>
                        <input name="phone" type="text" class="form-control bg-light fs-6 px-4 py-2"
                               placeholder="Nhập số điện thoại..." required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary">Mật khẩu</label>
                        <input name="password" type="password" class="form-control bg-light fs-6 px-4 py-2"
                               placeholder="Tạo mật khẩu..." required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                            Đăng Ký Tài Khoản
                        </button>
                    </div>

                    <div class="text-center">
                        <small class="text-muted">
                            Đã có tài khoản?
                            <a asp-action="Login" class="text-success fw-bold text-decoration-none">Đăng nhập ngay</a>
                        </small>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>