@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="row border rounded-5 p-3 bg-white shadow-lg box-area w-100" style="max-width: 900px;">
        
        <div class="col-md-6 rounded-4 d-flex justify-content-center align-items-center flex-column left-box p-4" style="background: linear-gradient(135deg, #198754 0%, #157347 100%);">
            <div class="featured-image mb-3 text-white text-center">
                <span style="font-size: 64px;">🌱</span>
            </div>
            <p class="text-white fs-2 text-center fw-bold">Gia nhập EcoSync</p>
            <p class="text-white text-center small" style="opacity: 0.85; line-height: 1.6;">Đăng ký tài khoản tình nguyện viên để cùng chung tay bảo vệ môi trường, nhận Giấy chứng nhận và tham gia các chiến dịch ý nghĩa.</p>
        </div>

        <div class="col-md-6 right-box d-flex justify-content-center align-items-center p-4">
            <div class="row align-items-center w-100">
                <div class="header-text mb-3 text-center">
                    <h3 class="fw-bold text-dark">Tạo tài khoản</h3>
                    <p class="text-muted small">Điền thông tin để trở thành thành viên EcoSync.</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 small rounded-3 text-center">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Họ và tên</label>
                        <input name="fullName" type="text" class="form-control bg-light fs-6 rounded-pill px-4 py-2" placeholder="Nhập họ tên đầy đủ..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Email</label>
                        <input name="email" type="email" class="form-control bg-light fs-6 rounded-pill px-4 py-2" placeholder="Nhập địa chỉ email..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Số điện thoại</label>
                        <input name="phone" type="text" class="form-control bg-light fs-6 rounded-pill px-4 py-2" placeholder="Nhập số điện thoại..." required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary">Mật khẩu</label>
                        <input name="password" type="password" class="form-control bg-light fs-6 rounded-pill px-4 py-2" placeholder="Tạo mật khẩu..." required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm">Đăng Ký Tài Khoản</button>
                    </div>

                    <div class="text-center">
                        <small class="text-muted">Đã có tài khoản? <a asp-action="Login" class="text-success fw-bold text-decoration-none">Đăng nhập ngay</a></small>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>