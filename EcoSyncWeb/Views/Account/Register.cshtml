@{
    ViewData["Title"] = "Đăng ký";
}

<style>
    .auth-wrapper {
        max-width: 960px;
        border-radius: 2rem !important;
        overflow: hidden;
        box-shadow: 0 24px 48px -12px rgba(6, 78, 59, 0.16) !important;
        border: 1px solid rgba(16, 185, 129, 0.18) !important;
    }

    .auth-left-panel {
        background: linear-gradient(135deg, #064e3b 0%, #059669 55%, #0d9488 100%);
        border-radius: 1.65rem !important;
        position: relative;
        overflow: hidden;
    }

    .auth-featured-img {
        width: 100%;
        max-width: 340px;
        height: 230px;
        border-radius: 1.5rem;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        padding: 0.5rem;
    }

    .auth-featured-img img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 1.25rem !important;
        mix-blend-mode: screen;
    }
</style>

<div class="container d-flex justify-content-center align-items-center py-4 animate-fade-up" style="min-height: 82vh;">
    <div class="row p-3 bg-white w-100 auth-wrapper">

        <!-- Cột trái -->
        <div class="col-md-6 d-flex justify-content-center align-items-center flex-column auth-left-panel p-4 p-md-5 text-white">
            <div class="auth-featured-img mb-3 text-center">
                <img src="~/dangnhap.jpg" asp-append-version="true" alt="EcoSync" class="img-fluid" />
            </div>
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                ✨ Trở thành Tình nguyện viên Xanh
            </span>
            <h2 class="fw-extrabold text-center mb-2">Gia Nhập EcoSync</h2>
            <p class="text-white text-center small mb-0" style="opacity: 0.88; line-height: 1.65;">
                Đăng ký tài khoản tình nguyện viên để cùng chung tay bảo vệ môi trường, nhận Giấy chứng nhận điện tử và tham gia các chiến dịch ý nghĩa tại Đà Nẵng.
            </p>
        </div>

        <!-- Cột phải -->
        <div class="col-md-6 d-flex justify-content-center align-items-center p-4 p-md-5">
            <div class="w-100">
                <div class="mb-3 text-center text-md-start">
                    <h3 class="fw-extrabold text-dark mb-1">Tạo tài khoản mới 🌱</h3>
                    <p class="text-muted small mb-0">Điền thông tin bên dưới để trở thành thành viên EcoSync.</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 px-3 small text-center rounded-4 border-0">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">👤 Họ và tên</label>
                        <input name="fullName" type="text" class="form-control rounded-pill px-4 py-2"
                               placeholder="Nhập họ tên đầy đủ..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">📧 Email</label>
                        <input name="email" type="email" class="form-control rounded-pill px-4 py-2"
                               placeholder="Nhập địa chỉ email..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">📞 Số điện thoại</label>
                        <input name="phone" type="text" class="form-control rounded-pill px-4 py-2"
                               placeholder="Nhập số điện thoại (10 số)..." required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark">🔒 Mật khẩu</label>
                        <input name="password" type="password" class="form-control rounded-pill px-4 py-2"
                               placeholder="Tạo mật khẩu (tối thiểu 8 ký tự)..." required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm">
                            ✨ Đăng Ký Tài Khoản
                        </button>
                    </div>

                    <div class="text-center pt-2 border-top">
                        <small class="text-muted">
                            Đã có tài khoản?
                            <a asp-action="Login" class="text-success fw-bold text-decoration-none ms-1">Đăng nhập ngay →</a>
                        </small>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>