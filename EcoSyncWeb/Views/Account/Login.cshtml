@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .auth-wrapper {
        max-width: 940px;
        border-radius: 2rem !important;
        overflow: hidden;
        box-shadow: 0 24px 48px -12px rgba(6, 78, 59, 0.16) !important;
        border: 1px solid rgba(16, 185, 129, 0.18) !important;
    }

    .auth-left-panel {
        background: linear-gradient(135deg, #064e3b 0%, #059669 55%, #0d9488 100%);
        border-radius: 1.65rem !important;
        position: relative;
        overflow: hidden;
    }

    .auth-left-panel::before {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
        top: -60px;
        right: -60px;
        border-radius: 50%;
    }

    .auth-featured-img {
        width: 100%;
        max-width: 340px;
        height: 230px;
        border-radius: 1.5rem;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        padding: 0.5rem;
    }

    .auth-featured-img img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 1.25rem !important;
        mix-blend-mode: screen;
    }
</style>

<div class="container d-flex justify-content-center align-items-center py-4 animate-fade-up" style="min-height: 78vh;">
    <div class="row p-3 bg-white w-100 auth-wrapper">

        <!-- Cột trái -->
        <div class="col-md-6 d-flex justify-content-center align-items-center flex-column auth-left-panel p-4 p-md-5 text-white">
            <div class="auth-featured-img mb-3 text-center">
                <img src="~/dangnhap.jpg" asp-append-version="true" alt="EcoSync" class="img-fluid" />
            </div>
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                🌱 Cộng đồng Tình nguyện Đà Nẵng
            </span>
            <h2 class="fw-extrabold text-center mb-2">EcoSync Platform</h2>
            <p class="text-white text-center small mb-0" style="opacity: 0.88; line-height: 1.65;">
                Nền tảng quản lý dự án cộng đồng thông minh, tích hợp AI phỏng vấn &amp; lan tỏa lối sống xanh bền vững.
            </p>
        </div>

        <!-- Cột phải -->
        <div class="col-md-6 d-flex justify-content-center align-items-center p-4 p-md-5">
            <div class="w-100">
                <div class="mb-4 text-center text-md-start">
                    <h3 class="fw-extrabold text-dark mb-1">Chào mừng trở lại! 👋</h3>
                    <p class="text-muted small mb-0">Vui lòng đăng nhập để tiếp tục hành trình xanh cùng EcoSync.</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 px-3 small text-center rounded-4 border-0">
                        @TempData["ErrorMessage"]
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 px-3 small text-center rounded-4 border-0">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">📧 Địa chỉ Email</label>
                        <input name="Email" type="email"
                               class="form-control rounded-pill px-4 py-2"
                               placeholder="Nhập email của bạn..." required />
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label fw-bold small text-dark mb-1">🔒 Mật khẩu</label>
                            <a asp-action="ForgotPassword" class="small text-success fw-semibold text-decoration-none">Quên mật khẩu?</a>
                        </div>
                        <input name="Password" type="password"
                               class="form-control rounded-pill px-4 py-2"
                               placeholder="Nhập mật khẩu..." required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm">
                            🚀 Đăng Nhập
                        </button>
                    </div>

                    <div class="text-center pt-2 border-top">
                        <small class="text-muted">
                            Chưa có tài khoản?
                            <a asp-action="Register" class="text-success fw-bold text-decoration-none ms-1">Đăng ký ngay →</a>
                        </small>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>