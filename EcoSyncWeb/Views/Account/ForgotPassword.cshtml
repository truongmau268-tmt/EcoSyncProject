@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container d-flex justify-content-center align-items-center animate-fade-up" style="min-height: 72vh;">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white w-100" style="max-width: 490px;">
        <div class="eco-page-header rounded-0 py-4 text-center">
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                📧 Hỗ trợ khôi phục tài khoản
            </span>
            <h4 class="mb-0 fw-extrabold">Khôi Phục Mật Khẩu</h4>
        </div>
        <div class="card-body p-4 p-md-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-4 border-0 small" role="alert">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-4 border-0 small" role="alert">@TempData["ErrorMessage"]</div>
            }

            <p class="text-muted small mb-4" style="line-height: 1.6;">
                Nhập địa chỉ email bạn đã đăng ký với EcoSync. Hệ thống sẽ gửi liên kết đặt lại mật khẩu có hiệu lực trong 15 phút.
            </p>
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label for="email" class="form-label fw-bold small text-dark">📧 Email đã đăng ký</label>
                    <input id="email" name="email" type="email" class="form-control rounded-pill px-4 py-2"
                           placeholder="Nhập email tài khoản của bạn..." autocomplete="email" required />
                </div>
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm">
                        📩 Gửi Liên Kết Khôi Phục
                    </button>
                </div>
            </form>
            <div class="text-center pt-2 border-top">
                <a asp-action="Login" class="small text-secondary fw-semibold text-decoration-none">⬅ Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>
