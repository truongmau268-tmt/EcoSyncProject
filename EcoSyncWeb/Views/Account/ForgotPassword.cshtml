@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-sm border-0 rounded-4 w-100" style="max-width: 480px;">
        <div class="card-header bg-success text-white py-3 text-center rounded-top-4">
            <h4 class="mb-0 fw-bold">Khôi phục mật khẩu qua email</h4>
        </div>
        <div class="card-body p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-3 small" role="alert">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-3 small" role="alert">@TempData["ErrorMessage"]</div>
            }

            <p class="text-muted small">Nhập email đã đăng ký. Chúng tôi sẽ gửi liên kết đặt lại mật khẩu có hiệu lực trong 15 phút.</p>
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label for="email" class="form-label fw-bold small text-secondary">Email đã đăng ký</label>
                    <input id="email" name="email" type="email" class="form-control rounded-pill px-3"
                           placeholder="Nhập email tài khoản của bạn..." autocomplete="email" required />
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-success fw-bold rounded-pill py-2">Gửi yêu cầu</button>
                </div>
            </form>
            <div class="text-center mt-3">
                <a asp-action="Login" class="small text-decoration-none">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>
