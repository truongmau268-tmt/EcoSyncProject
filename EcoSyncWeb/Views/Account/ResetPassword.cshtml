@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container d-flex justify-content-center align-items-center animate-fade-up" style="min-height: 72vh;">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white w-100" style="max-width: 490px;">
        <div class="eco-page-header rounded-0 py-4 text-center">
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                🔐 Thiết lập lại bảo mật
            </span>
            <h4 class="mb-0 fw-extrabold">Đặt Lại Mật Khẩu Mới</h4>
        </div>
        <div class="card-body p-4 p-md-5">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-4 border-0 small" role="alert">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="email" value="@ViewBag.Email" />
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div class="mb-3">
                    <label for="newPassword" class="form-label fw-bold small text-dark">✨ Mật khẩu mới (tối thiểu 8 ký tự)</label>
                    <input id="newPassword" name="newPassword" type="password" class="form-control rounded-pill px-4 py-2"
                           minlength="8" autocomplete="new-password" placeholder="Nhập mật khẩu mới..." required />
                </div>
                <div class="mb-4">
                    <label for="confirmPassword" class="form-label fw-bold small text-dark">✅ Xác nhận mật khẩu mới</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" class="form-control rounded-pill px-4 py-2"
                           autocomplete="new-password" placeholder="Nhập lại mật khẩu mới..." required />
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm">
                        💾 Xác Nhận Đặt Lại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
