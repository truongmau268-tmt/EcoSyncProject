@model IEnumerable<EcoSyncWeb.Models.User>
@{
    ViewData["Title"] = "Quản lý thành viên";
    var keyword = ViewBag.Keyword as string;
    var currentEmail = ViewBag.CurrentEmail as string;
}

<div class="container mt-3 mb-5 animate-fade-up">
    <div class="eco-page-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 mb-2 fw-semibold">
                🛡 Quản trị Tài khoản &amp; Phân quyền
            </span>
            <h2 class="fw-extrabold mb-1">👥 Quản Lý Thành Viên Hệ Thống</h2>
            <p class="mb-0 text-white text-opacity-85 small">
                Danh sách tài khoản tình nguyện viên và quản trị viên — hỗ trợ tìm kiếm và khóa/mở khóa tài khoản vi phạm.
            </p>
        </div>
        <a asp-controller="Project" asp-action="Index" class="btn btn-light fw-bold rounded-pill px-4 text-success shadow-sm flex-shrink-0">
            ⬅ Về danh sách dự án
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm text-center border-0" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm text-center border-0" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-action="Users" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill ps-3 text-muted">🔍</span>
                    <input type="text" name="keyword" value="@keyword" class="form-control border-start-0 rounded-end-pill px-3" placeholder="Tìm theo họ tên, email hoặc số điện thoại..." />
                </div>
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-success rounded-pill fw-bold py-2">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table eco-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="py-3 ps-4">Thành viên &amp; Kỹ năng</th>
                        <th class="py-3">Thông tin liên hệ</th>
                        <th class="py-3 text-center">Vai trò</th>
                        <th class="py-3 text-center">Trạng thái</th>
                        <th class="py-3 pe-4 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var initial = !string.IsNullOrWhiteSpace(u.FullName) ? u.FullName.Trim()[0].ToString().ToUpper() : "U";
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="eco-avatar">@initial</span>
                                    <div>
                                        <div class="fw-bold text-dark">@u.FullName</div>
                                        @if (!string.IsNullOrWhiteSpace(u.Skills))
                                        {
                                            <div class="small text-muted">🛠 @u.Skills</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="small text-muted">
                                <div><i class="bi bi-envelope me-1"></i>@u.Email</div>
                                <div><i class="bi bi-telephone me-1"></i>@u.Phone</div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(u.Role == "Admin" ? "bg-primary" : "bg-success bg-opacity-10 text-success border border-success border-opacity-25") px-3 py-2 rounded-pill">
                                    @(u.Role == "Admin" ? "👑 Quản trị viên" : "🌱 Cộng tác viên")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (u.IsBlocked)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">🚫 Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">✅ Hoạt động</span>
                                }
                            </td>
                            <td class="pe-4 text-center">
                                @if (u.Email == currentEmail)
                                {
                                    <span class="badge bg-light text-muted border rounded-pill px-3 py-2">Tài khoản của bạn</span>
                                }
                                else if (u.IsBlocked)
                                {
                                    <a asp-action="ToggleBlock" asp-route-id="@u.Id" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">🔓 Mở khóa</a>
                                }
                                else
                                {
                                    <a asp-action="ToggleBlock" asp-route-id="@u.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold"
                                       onclick="return confirm('Khóa tài khoản @u.Email? Tài khoản này sẽ không thể đăng nhập cho đến khi được mở khóa.');">🔒 Khóa</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
