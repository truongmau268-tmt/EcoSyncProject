@model IEnumerable<EcoSyncWeb.Models.User>
@{
    ViewData["Title"] = "Quản lý thành viên";
    var keyword = ViewBag.Keyword as string;
    var currentEmail = ViewBag.CurrentEmail as string;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-success mb-1">👥 Quản lý thành viên</h2>
            <p class="text-muted mb-0">Danh sách tài khoản hệ thống — khóa/mở khóa cộng tác viên vi phạm.</p>
        </div>
        <a asp-controller="Project" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">⬅ Về danh sách dự án</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm text-center" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm text-center" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
        <form asp-action="Users" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <input type="text" name="keyword" value="@keyword" class="form-control rounded-pill px-3" placeholder="🔍 Tìm theo họ tên, email hoặc số điện thoại..." />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-success rounded-pill fw-bold">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 ps-4">Thành viên</th>
                        <th class="py-3">Liên hệ</th>
                        <th class="py-3 text-center">Vai trò</th>
                        <th class="py-3 text-center">Trạng thái</th>
                        <th class="py-3 pe-4 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@u.FullName</div>
                                @if (!string.IsNullOrWhiteSpace(u.Skills))
                                {
                                    <div class="small text-muted">🛠 @u.Skills</div>
                                }
                            </td>
                            <td class="small text-muted">
                                @u.Email<br />@u.Phone
                            </td>
                            <td class="text-center">
                                <span class="badge @(u.Role == "Admin" ? "bg-primary" : "bg-info text-dark") px-3 py-2 rounded-pill">@(u.Role == "Admin" ? "Quản trị viên" : "Cộng tác viên")</span>
                            </td>
                            <td class="text-center">
                                @if (u.IsBlocked)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">🚫 Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">✅ Hoạt động</span>
                                }
                            </td>
                            <td class="pe-4 text-center">
                                @if (u.Email == currentEmail)
                                {
                                    <span class="small text-muted fst-italic">(tài khoản của bạn)</span>
                                }
                                else if (u.IsBlocked)
                                {
                                    <a asp-action="ToggleBlock" asp-route-id="@u.Id" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">🔓 Mở khóa</a>
                                }
                                else
                                {
                                    <a asp-action="ToggleBlock" asp-route-id="@u.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold"
                                       onclick="return confirm('Khóa tài khoản @u.Email? Tài khoản này sẽ không thể đăng nhập cho đến khi được mở khóa.');">🔒 Khóa</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
